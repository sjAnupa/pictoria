# Local dev: use /api so Vite proxies to http://localhost:5000 (server must be running)
VITE_API_URL=/api
# Set when R2 is configured (optional in local dev — API returns full R2 URLs)
VITE_R2_PUBLIC_URL=
# Google OAuth Web client ID (public — safe in frontend bundle)
VITE_GOOGLE_CLIENT_ID=
# Facebook App ID (public)
VITE_FACEBOOK_APP_ID=
